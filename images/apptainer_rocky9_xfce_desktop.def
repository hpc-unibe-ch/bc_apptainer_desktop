Bootstrap: docker

From: rockylinux/rockylinux:9

%environment
  PATH=/opt/TurboVNC/bin:$PATH
  LANGUAGE="en_US.UTF-8"
  LC_ALL="en_US.UTF-8"
  LANG="en_US.UTF-8"

%post
    dnf install -y dnf-plugins-core
    dnf config-manager --set-enabled crb
    dnf -y update && dnf -y upgrade
    dnf install -y epel-release
    dnf groupinstall -y xfce
    dnf install -y python3-pip xorg-x11-xauth procps-ng wget
    dnf install -y python3-websockify
    # Install NVIDIA driver libraries
    dnf config-manager --add-repo=https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64/cuda-rhel9.repo
    dnf -y install nvidia-driver-libs
    pip3 install ts
    # Install TurboVNC
    cd /etc/yum.repos.d && wget https://raw.githubusercontent.com/TurboVNC/repo/main/TurboVNC.repo && dnf install -y turbovnc
    # Cleanup
    dnf clean all
    rm -rf /var/cache/dnf/*
    rm -f /var/log/*.log
